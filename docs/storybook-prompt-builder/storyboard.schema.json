{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storyboard",
  "type": "object",
  "required": ["title", "parts", "plates"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "style_identity": {
      "type": "object",
      "description": "Presente solo quando si importa uno storyboard che contiene il blocco di identità grafica",
      "properties": {
        "technique": { "type": "string" },
        "character_style": { "type": "string" },
        "mood": { "type": "string" },
        "negatives": { "type": "array", "items": { "type": "string" } }
      }
    },
    "characters": {
      "type": "array",
      "description": "Descrizioni dei personaggi trovate nel testo importato (opzionale)",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string", "enum": ["protagonist", "secondary"] },
          "age_label": { "type": "string" },
          "canonical": { "type": "string" },
          "key_features": { "type": "array", "items": { "type": "string" } },
          "outfit_default": { "type": "string" },
          "never": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "fixed_objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "never": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "asset_alias": { "type": "string" }
        }
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    },
    "plates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "title", "scene", "text", "characters_present"],
        "additionalProperties": false,
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "part_id": { "type": "string" },
          "scene": { "type": "string", "description": "Blocco IMMAGINE: descrizione visiva dettagliata" },
          "text": { "type": "string", "description": "Blocco TESTO: dialoghi e narrazione, va in impaginazione" },
          "characters_present": { "type": "array", "items": { "type": "string" } },
          "outfit_tags": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "nome personaggio -> tag abito (es. notte)"
          },
          "environment": { "type": "string" },
          "asset_aliases": { "type": "array", "items": { "type": "string" } },
          "fixed_objects": { "type": "array", "items": { "type": "string" } },
          "new_objects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "description"],
              "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          },
          "continuity_notes": { "type": "string" },
          "continuity_plates": { "type": "array", "items": { "type": "integer" } },
          "negatives": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "continuity_rules": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Controlli di continuità globali"
    }
  }
}
